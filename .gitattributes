# Enforce consistent line endings across all platforms
* text=auto eol=lf

# Explicitly declare text files
*.js       text eol=lf
*.jsx      text eol=lf
*.cjs      text eol=lf
*.ts       text eol=lf
*.tsx      text eol=lf
*.json     text eol=lf
*.css      text eol=lf
*.html     text eol=lf
*.md       text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.env      text eol=lf
*.example  text eol=lf
*.txt      text eol=lf
.gitignore text eol=lf

# Binary files — do not touch line endings
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary
*.svg      binary
*.woff     binary
*.woff2    binary
*.ttf      binary
*.eot      binary
